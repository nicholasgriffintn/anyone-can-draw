{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starterjam",
  "main": "api/index.ts",
  "compatibility_date": "2025-04-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "anyonecandraw.app",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_NAME": "Anyone Can Draw",
    "ENVIRONMENT": "production",
    "APP_VERSION": "1.0.0",
    "DRAWING_API_BASE_URL": "https://api.polychat.app"
  },
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "MULTIPLAYER",
        "class_name": "Multiplayer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Multiplayer"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  }
}
